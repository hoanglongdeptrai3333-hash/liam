let data=JSON.parse(localStorage.getItem('gameData'))||{},ten="",soDu=0,soNo=0;
let txInt=null,txTime=15,txPhase='waiting',crTimer=null,cMul=3,cPoint=0,cCrashed=false,cBet=0,stTimer=null,stMul=1,stRunning=false,stBet=0,last64=false;
let coinRunning=false;
const fmt=s=>s.toLocaleString('vi-VN')+' đ',show=id=>document.getElementById(id).classList.remove('hidden'),hide=id=>document.getElementById(id).classList.add('hidden'),saveData=()=>localStorage.setItem('gameData',JSON.stringify(data));

// BẢO TRÌ 2 PHÚT
window.addEventListener('load',()=>{
    let timeLeft=120;
    show('maintenance');
    let countdownEl=document.getElementById('countdownText');
    countdownEl.innerText=timeLeft;
    let timer=setInterval(()=>{
        timeLeft--;
        if(timeLeft<=0){clearInterval(timer);hide('maintenance')}
        else{countdownEl.innerText=timeLeft}
    },1000)
});

function playSound(type){try{let ctx=new(window.AudioContext||window.webkitAudioContext)(),osc=ctx.createOscillator(),gain=ctx.createGain();osc.connect(gain);gain.connect(ctx.destination);if(type==='win'){osc.type='sine';osc.frequency.setValueAtTime(1200,ctx.currentTime);osc.frequency.exponentialRampToValueAtTime(2000,ctx.currentTime+0.1);gain.gain.setValueAtTime(0.5,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.01,ctx.currentTime+0.5);osc.start();osc.stop(ctx.currentTime+0.5)}else if(type==='lose'){osc.type='sawtooth';osc.frequency.setValueAtTime(300,ctx.currentTime);osc.frequency.exponentialRampToValueAtTime(100,ctx.currentTime+0.3);gain.gain.setValueAtTime(0.3,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.01,ctx.currentTime+0.3);osc.start();osc.stop(ctx.currentTime+0.3)}}catch(e){}}

function bungPhaoGiay(){for(let i=0;i<30;i++){let conf=document.createElement('div');conf.classList.add('confetti');conf.style.left=Math.random()*100+'vw';conf.style.backgroundColor=['#f1c40f','#e74c3c','#2ecc71','#3498db','#9b59b6'][Math.floor(Math.random()*5)];conf.style.animationDuration=(Math.random()*2+2)+'s';document.body.appendChild(conf);setTimeout(()=>conf.remove(),4000)}}

function layHangVip(tongCuoc){if(tongCuoc>=500000000)return{ten:'KIM CƯƠNG',class:'vip-4',thue:0};if(tongCuoc>=100000000)return{ten:'VÀNG',class:'vip-3',thue:0.01};if(tongCuoc>=20000000)return{ten:'BẠC',class:'vip-2',thue:0.015};if(tongCuoc>=5000000)return{ten:'ĐỒNG',class:'vip-1',thue:0.02};return{ten:'TÂN THỦ',class:'vip-0',thue:0.02}}

const chipValues=[50000,100000,200000,500000,1000000,2000000,5000000,10000000,20000000,50000000,100000000];
function renderChips(cId,iId){let h='';chipValues.forEach(v=>{let l=(v>=1000000)?(v/1000000)+'M':(v/1000)+'k';h+=`<div class="chip" onclick="document.getElementById('${iId}').value=${v}">${l}</div>`});document.getElementById(cId).innerHTML=h}
renderChips('chipsTx','betTx');renderChips('chipsCrash','betCrash');renderChips('chipsStone','betStone');renderChips('chipsCoin','betCoin');

function showToast(msg){document.getElementById('toastTxt').innerText=msg;document.getElementById('toast').classList.add('show');setTimeout(()=>document.getElementById('toast').classList.remove('show'),4000)}
function switchTab(i){for(let j=0;j<4;j++){document.getElementById('tabBtn'+j).classList.remove('active');hide('tab'+j)}document.getElementById('tabBtn'+i).classList.add('active');show('tab'+i);if(i===0&&!txInt)startTxLoop()}
function themLichSu(noiDung,soTien,loai){if(!data[ten].history)data[ten].history=[];let thoiGian=new Date().toLocaleString('vi-VN');data[ten].history.unshift({time:thoiGian,msg:noiDung,amount:soTien,type:loai});if(data[ten].history.length>50)data[ten].history.pop();saveData()}

function capNhat(){
    document.getElementById('displayBalance').innerText=fmt(soDu);
    let dEl=document.getElementById('displayDebt');
    if(soNo>0){dEl.style.display='block';dEl.innerText='Nợ: '+fmt(soNo);document.getElementById('payDebtBtn').style.display='block'}else{dEl.style.display='none';document.getElementById('payDebtBtn').style.display='none'}
    let vip=layHangVip(data[ten].totalBet||0),badge=document.getElementById('vipBadge');
    badge.innerText=vip.ten;badge.className='vip-tag '+vip.class;
    if(soNo>0){if(!data[ten].debtStart)data[ten].debtStart=Date.now();else{let days=(Date.now()-data[ten].debtStart)/(1000*60*60*24);if(days>=3){data[ten].isBanned=true;saveData();alert("TÀI KHOẢN BỊ KHÓA DO NỢ QUÁ 3 NGÀY!");location.reload()}}}else data[ten].debtStart=null;
    if(data[ten]){data[ten].soDu=soDu;data[ten].soNo=soNo;saveData()}
    let h=soDu>0;
    if(!h){document.getElementById('btnStartCrash').style.display='none';document.getElementById('btnStartStone').style.display='none';show('loanControls')}else{if(!crTimer)document.getElementById('btnStartCrash').style.display='block';if(!stRunning)document.getElementById('btnStartStone').style.display='block';hide('loanControls')}
}

function dangKy(){let u=document.getElementById('usernameInput').value.trim().toLowerCase(),p=document.getElementById('passwordInput').value.trim();if(!u||!p)return alert("Nhập Tên và Mật khẩu!");if(data[u])return alert("Tên đã tồn tại!");data[u]={pass:p,soDu:500000,soNo:0,isBanned:false,isAdmin:false,history:[],totalBet:0,usedCode:false};saveData();alert("Đăng ký thành công! Nhận 500.000đ.")}
function dangNhap(){let u=document.getElementById('usernameInput').value.trim().toLowerCase(),p=document.getElementById('passwordInput').value.trim();if(!u||!p)return alert("Nhập Tên và Mật khẩu!");if(u==='liam'&&p==='231213'){if(!data['liam'])data['liam']={soDu:2000000000,soNo:0,isBanned:false,isAdmin:true,history:[],totalBet:0,usedCode:false};data['liam'].isAdmin=true;saveData()}else{if(!data[u])return alert("Tài khoản không tồn tại!");if(data[u].pass!==p)return alert("Sai mật khẩu!");if(data[u].isBanned)return alert("TÀI KHOẢN ĐÃ BỊ BAN!")}ten=u;document.getElementById('displayName').innerText=ten;soDu=data[ten].soDu;soNo=data[ten].soNo;if(data[ten].isAdmin)document.getElementById('adminBtn').style.display='block';else document.getElementById('adminBtn').style.display='none';capNhat();hide('loginScreen');show('gameScreen');startTxLoop()}

function startTxLoop(){txTime=15;txPhase='betting';capNhat();if(txInt)clearInterval(txInt);txInt=setInterval(()=>{txTime--;let t=document.getElementById('txTimer');if(txTime>2){t.innerText=`Cược: ${txTime}s`;t.style.color='#f1c40f'}else if(txTime>0){t.innerText=`Khóa: ${txTime}s`;t.style.color='#e74c3c';txPhase='locked';capNhat()}else{txPhase='rolling';t.innerText='Lắc...';t.style.color='#2ecc71';clearInterval(txInt);txInt=null;lacXucXac()}},1000)}

function cuocTx(){if(txPhase!=='betting')return alert("Đã khóa!");let val=document.getElementById('betTx').value.trim();if(!val)return alert("Nhập cược!");let parts=val.split(' ');if(parts.length!==2)return alert("Sai cú pháp!");let tien=parseFloat(parts[0]),cua=parts[1];if(isNaN(tien)||tien<50000)return alert("Min 50k!");if(tien>soDu)return alert("Thiếu tiền!");let type='tai';if(cua==='1')type='tai';else if(cua==='2')type='xiu';else return alert("Cửa sai!");soDu-=tien;data[ten].pendingBet={type:type,amount:tien};data[ten].totalBet=(data[ten].totalBet||0)+tien;themLichSu(`Cược Tài Xỉu (${cua})`,tien,'cuoc');capNhat();document.getElementById('resTx').innerText=`Đã đặt ${cua} - ${fmt(tien)}`;document.getElementById('resTx').style.color='#f1c40f'}

function lacXucXac(){
    let d1=document.getElementById('d1'),dem=0;
    let itv=setInterval(()=>{
        let x=Math.floor(Math.random()*10)+1;
        if(x===2||x===10){return;}
        d1.innerText=x;dem++;
        if(dem>15){
            clearInterval(itv);
            let laTai=[4,9,1,0].includes(x),laXiu=[3,5,7,6,8].includes(x);
            let rd=document.getElementById('resTx');rd.innerText=`Kết quả: ${x} - `+(laTai?"TÀI":"XỈU");rd.style.color=laTai?'#2ecc71':'#e74c3c';
            let bet=data[ten].pendingBet;
            if(bet){
                let win=0;
                if((bet.type==='tai'&&laTai)||(bet.type==='xiu'&&laXiu)){win=bet.amount*2;}
                if(win>0){let vip=layHangVip(data[ten].totalBet);if(win>=1000000){let thue=win*vip.thue;win-=thue;rd.innerText+=` (Thuế ${vip.thue*100}%)`}soDu+=Math.floor(win);playSound('win');if(win>=10000000){showToast(`🔥 ${ten} thắng +${fmt(win)}!`);bungPhaoGiay()}themLichSu(`Thắng Tài Xỉu`,win,'thang')}else{playSound('lose');rd.innerText+=' - THUA!';}
            }
            data[ten].pendingBet=null;capNhat();document.getElementById('betTx').value="";
            setTimeout(()=>{startTxLoop()},3000);
        }
    },50)
}

function startCrash(){
    if(crTimer)return;
    cBet=parseFloat(document.getElementById('betCrash').value);
    if(isNaN(cBet)||cBet<50000)return alert("Min 50k!");
    if(cBet>soDu)return alert("Thiếu tiền!");
    soDu-=cBet;data[ten].totalBet=(data[ten].totalBet||0)+cBet;capNhat();cMul=3;cCrashed=false;
    themLichSu(`Cược Tên Lửa`,cBet,'cuoc');
    let r=Math.random();
    if(r<0.40){cPoint=Math.random()*2+3.0}else{let r2=Math.random();if(r2<0.7)cPoint=6.0;else if(r2<0.9)cPoint=24.0;else if(r2<0.98)cPoint=96.0;else{if(!last64){cPoint=64.0;last64=true}else cPoint=6.0}}
    let m=document.getElementById('multCrash'),rk=document.getElementById('rocketObj'),res=document.getElementById('resCrash');
    m.innerText="3.00x";m.style.color='#2ecc71';rk.innerText="🚀";res.innerText=`Thắng: 0 đ`;
    document.getElementById('btnStartCrash').style.display='none';document.getElementById('btnCashCrash').disabled=false;document.getElementById('betCrash').disabled=true;
    let st=Date.now();
    crTimer=setInterval(()=>{
        let tm=(Date.now()-st)/1000;cMul=3+Math.pow(tm,1.5)*(cPoint>10?0.5:1.0);
        let b=10+(cMul*2)%100,l=10+(cMul*4)%250;rk.style.bottom=b+'px';rk.style.left=l+'px';
        let tienThang=Math.floor((cBet/10000)*2000*cMul);res.innerText=`Thắng: ${fmt(tienThang)}`;
        if(cMul>=cPoint){clearInterval(crTimer);crTimer=null;cCrashed=true;m.innerText=cMul.toFixed(2)+"x (NỔ)";m.style.color='#e74c3c';rk.innerText="💥";res.innerText=`Đã nổ! Mất ${fmt(cBet)}`;playSound('lose');document.getElementById('btnCashCrash').disabled=true;document.getElementById('btnStartCrash').style.display='block';document.getElementById('betCrash').disabled=false;capNhat()}
        else{m.innerText=cMul.toFixed(2)+"x";document.getElementById('btnCashCrash').innerText=`CHỐT (${cMul.toFixed(2)}x)`}
    },30)
}

function cashCrash(){
    if(!crTimer||cCrashed)return;
    if(cMul<6.0)return alert("BẠN PHẢI ĐẠT 6.00X MỚI ĐƯỢC RÚT!");
    clearInterval(crTimer);crTimer=null;
    let win=Math.floor((cBet/10000)*2000*cMul);let vip=layHangVip(data[ten].totalBet);
    if(win>=1000000){let thue=win*vip.thue;win-=thue;alert(`Chốt (Thuế ${vip.thue*100}%)! Nhận: ${fmt(win)}`)}else alert(`Chốt! Nhận: ${fmt(win)}`);
    soDu+=Math.floor(win);playSound('win');if(win>=10000000){showToast(`🔥 ${ten} chốt +${fmt(win)}!`);bungPhaoGiay()}
    themLichSu(`Chốt Tên Lửa`,win,'thang');
    document.getElementById('rocketObj').innerText="🚀";document.getElementById('btnCashCrash').disabled=true;document.getElementById('btnStartCrash').style.display='block';document.getElementById('betCrash').disabled=false;capNhat()
}

function startStone(){
    if(stRunning)return;
    stBet=parseFloat(document.getElementById('betStone').value);
    if(isNaN(stBet)||stBet<50000)return alert("Min 50k!");
    if(stBet>soDu)return alert("Thiếu tiền!");
    soDu-=stBet;data[ten].totalBet=(data[ten].totalBet||0)+stBet;capNhat();stRunning=true;stMul=1;
    themLichSu(`Cược Đập Đá`,stBet,'cuoc');
    document.getElementById('btnStartStone').style.display='none';document.getElementById('btnStopStone').disabled=false;
    document.getElementById('stoneObj').innerText="🪨";document.getElementById('resStone').innerText=`Tiền: 0 đ`;
    stTimer=setInterval(()=>{
        stMul+=1;let cw=Math.floor((stBet/10000)*2000*stMul);document.getElementById('resStone').innerText=`Tiền: ${fmt(cw)}`;
        if(cw>=100000000000){clearInterval(stTimer);stRunning=false;let win=100000000000*0.98;alert(`Đá đạt 100B (Thuế 2%)! Nhận: ${fmt(win)}`);soDu+=Math.floor(win);showToast(`🔥 ${ten} chốt +${fmt(win)}!`);bungPhaoGiay();themLichSu(`Chốt Đá (Max)`,win,'thang');document.getElementById('btnStopStone').disabled=true;document.getElementById('btnStartStone').style.display='block';capNhat();return}
        if(Math.random()<0.25){clearInterval(stTimer);stRunning=false;document.getElementById('stoneObj').innerText="💥";document.getElementById('resStone').innerText=`Đá nát! Mất ${fmt(stBet)}`;playSound('lose');document.getElementById('btnStopStone').disabled=true;document.getElementById('btnStartStone').style.display='block';capNhat()}
    },1000)
}

function hitStone(){if(!stRunning)return;let st=document.getElementById('stoneObj');st.classList.add('hit');setTimeout(()=>st.classList.remove('hit'),100)}

function stopStone(){
    if(!stRunning)return;clearInterval(stTimer);stRunning=false;
    let win=Math.floor((stBet/10000)*2000*stMul);let vip=layHangVip(data[ten].totalBet);
    if(win>=1000000){let thue=win*vip.thue;win-=thue;alert(`Chốt (Thuế ${vip.thue*100}%)! Nhận: ${fmt(win)}`)}else alert(`Chốt! Nhận: ${fmt(win)}`);
    soDu+=Math.floor(win);playSound('win');if(win>=10000000){showToast(`🔥 ${ten} chốt +${fmt(win)}!`);bungPhaoGiay()}
    themLichSu(`Chốt Đá`,win,'thang');
    document.getElementById('btnStopStone').disabled=true;document.getElementById('btnStartStone').style.display='block';capNhat()
}

function latXu(cuaChon){
    if(coinRunning)return;
    let cuoc=parseFloat(document.getElementById('betCoin').value);
    if(isNaN(cuoc)||cuoc<50000)return alert("Min 50k!");
    if(cuoc>soDu)return alert("Thiếu tiền!");
    soDu-=cuoc;data[ten].totalBet=(data[ten].totalBet||0)+cuoc;capNhat();coinRunning=true;
    themLichSu(`Cược Lật Xu (${cuaChon})`,cuoc,'cuoc');
    let coin=document.getElementById('coinObj'),res=document.getElementById('resCoin'),flipCount=0;
    res.innerText="Đang lật...";res.style.color='#fff';
    let itv=setInterval(()=>{
        coin.innerText=flipCount%2===0?"🪙":"🔴";coin.style.transform=flipCount%2===0?"rotateY(0deg)":"rotateY(180deg)";flipCount++;
        if(flipCount>10){
            clearInterval(itv);let kq=Math.random()<0.5?'Sap':'Ngua';coin.style.transform="rotateY(0deg)";
            if(kq==='Sap'){coin.innerText="🪙";res.innerText="KẾT QUẢ: SẤP!"}else{coin.innerText="🔴";res.innerText="KẾT QUẢ: NGỬA!"}
            if(kq===cuaChon){
                let win=cuoc*2;let vip=layHangVip(data[ten].totalBet);
                if(win>=1000000){let thue=win*vip.thue;win-=thue;res.innerText+=` - THẮNG (Thuế ${vip.thue*100}%)! Nhận: ${fmt(win)}`}else res.innerText+=` - THẮNG! Nhận: ${fmt(win)}`;
                res.style.color='#2ecc71';soDu+=Math.floor(win);playSound('win');if(win>=10000000){showToast(`🔥 ${ten} thắng Lật Xu +${fmt(win)}!`);bungPhaoGiay()}themLichSu(`Thắng Lật Xu`,win,'thang')
            }else{res.innerText+=` - THUA! Mất ${fmt(cuoc)}`;res.style.color='#e74c3c';playSound('lose')}
            capNhat();coinRunning=false
        }
    },100)
}

function moMenu(){show('menuModal')}
function dongMenu(){hide('menuModal')}

function moLichSu(){
    dongMenu();
    let hList=document.getElementById('historyList');hList.innerHTML='';
    if(!data[ten].history||data[ten].history.length===0){hList.innerHTML='<div style="text-align:center;color:#aaa">Chưa có giao dịch.</div>'}
    else{data[ten].history.forEach(item=>{let color=item.type==='thang'?'#2ecc71':(item.type==='cuoc'?'#f1c40f':'#e74c3c');hList.innerHTML+=`<div class="history-item"><span style="color:#888;font-size:10px">${item.time}</span><br><span style="color:${color}">${item.msg}: ${fmt(item.amount)}</span></div>`})}
    show('historyModal')
}

function dongLichSu(){hide('historyModal')}

function moVay(){dongMenu();document.getElementById('loanAmount').value="";show('loanModal')}

function xacNhanVay(){
    let amount=parseFloat(document.getElementById('loanAmount').value);
    if(isNaN(amount)||amount<10000)return alert("Min 10k!");
    let liamData=data['liam']||{};
    if(amount>liamData.soDu)return alert("Admin Liam không đủ tiền để cho vay!");
    if(!data['requests'])data['requests']=[];
    data['requests'].push({user:ten,amount:amount,time:new Date().toLocaleString('vi-VN')});
    saveData();dongModal();alert("Đã gửi yêu cầu vay đến Admin Liam. Vui lòng chờ duyệt!")
}

function dongModal(){hide('loanModal')}

function moTraNo(){document.getElementById('currentDebt').innerText=fmt(soNo);document.getElementById('payAmount').value="";show('payDebtModal')}

function dongTraNo(){hide('payDebtModal')}

function xacNhanTraNo(){
    let amount=parseFloat(document.getElementById('payAmount').value);
    if(isNaN(amount)||amount<10000)return alert("Min 10k!");
    if(amount>soDu)return alert("Không đủ tiền mặt!");
    if(amount>soNo)amount=soNo;
    soDu-=amount;soNo-=amount;themLichSu(`Trả nợ Admin`,amount,'vay');dongTraNo();capNhat();alert(`Đã trả ${fmt(amount)}. Còn nợ: ${fmt(soNo)}`)
}

function moAdmin(){
    let tbody=document.querySelector('#adminTable tbody');tbody.innerHTML='';
    for(let t in data){
        if(t==='requests'||t==='liam')continue;
        let u=data[t],banBtn=u.isBanned?`<button onclick="unban('${t}')" style="background:orange;padding:2px">Mở</button>`:`<button onclick="ban('${t}')" style="background:#e74c3c;padding:2px">Ban</button>`;
        tbody.innerHTML+=`<tr style="${u.isBanned?'opacity:0.5':''}"><td>${t}</td><td>${fmt(u.soDu)}</td><td><input type="number" id="in_${t}" class="adm-inp"><button onclick="sua('${t}')" style="background:#2ecc71;padding:2px">Sửa</button></td><td>${banBtn}</td></tr>`
    }
    let loanTbody=document.querySelector('#loanTable tbody');loanTbody.innerHTML='';
    if(!data['requests']||data['requests'].length===0){loanTbody.innerHTML='<tr><td colspan="3" style="text-align:center;color:#888">Không có yêu cầu</td></tr>'}
    else{data['requests'].forEach((req,i)=>{loanTbody.innerHTML+=`<tr><td>${req.user}</td><td>${fmt(req.amount)}</td><td><button onclick="duyetVay(${i})" style="background:#2ecc71;padding:2px">Duyệt</button><button onclick="tuChoiVay(${i})" style="background:#e74c3c;padding:2px">Hủy</button></td></tr>`})}
    show('adminModal')
}

function dongAdmin(){hide('adminModal')}

function sua(t){
    let val=parseFloat(document.getElementById(`in_${t}`).value);
    if(isNaN(val))return alert("Nhập tiền!");
    data[t].soDu+=val;
    if(t===ten){soDu=data[t].soDu;capNhat()}
    moAdmin()
}

function ban(t){if(t==='liam')return alert("Không thể ban mình!");if(confirm("Ban acc này?")){data[t].isBanned=true;saveData();moAdmin()}}
function unban(t){data[t].isBanned=false;saveData();moAdmin()}

function duyetVay(i){
    let req=data['requests'][i];let u=req.user,amt=req.amount;
    if(!data[u])return;
    if(data['liam'].soDu<amt)return alert("Bạn không đủ tiền!");
    data['liam'].soDu-=amt;
    if(data[u].soDu<0){data[u].soDu+=amt}else{data[u].soDu+=amt}
    data['requests'].splice(i,1);saveData();
    if(ten==='liam'){soDu=data['liam'].soDu;capNhat()}
    moAdmin();alert(`Đã duyệt ${fmt(amt)} cho ${u}`)
}

function tuChoiVay(i){if(!confirm("Hủy yêu cầu này?"))return;data['requests'].splice(i,1);saveData();moAdmin()}

// CHAT WEBSOCKET
const ws = new WebSocket('wss://ws.postman-echo.com/raw');
ws.onmessage = function(event) {
    try {
        let msg = JSON.parse(event.data);
        if(msg.type === 'chat') {
            let box = document.getElementById('chatMsgs');
            if(box) {
                box.innerHTML += `<div class="c-msg"><span>${msg.user}:</span> ${msg.text}</div>`;
                box.scrollTop = box.scrollHeight;
                if(msg.text.toLowerCase() === 'admin đz' && data[msg.user] && !data[msg.user].usedCode) {
                    data[msg.user].soDu += 300000;
                    data[msg.user].usedCode = true;
                    saveData();
                    if(msg.user === ten) { soDu = data[ten].soDu; capNhat(); }
                    box.innerHTML += `<div class="c-msg" style="color:#00ff88">Hệ thống: ${msg.user} đã nhận 300k vì khen Admin!</div>`;
                }
            }
        }
    } catch(e) {}
};

function guiChat(){
    let inp=document.getElementById('chatInput');
    if(!inp.value.trim())return;
    let text=inp.value.trim();
    if(ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({type: 'chat', user: ten, text: text}));
    } else {
        alert("Đang kết nối lại chat, vui lòng thử lại sau!");
    }
    inp.value='';
}
